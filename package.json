{
  "name": "zedlint",
  "description": "An opinionated linting orchestrator for ESLint, Stylelint, and Markdownlint.",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zedlint/zedlint.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "zedlint": "./lib/index.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rimraf lib && mkdir lib && rollup -c",
    "lint": "tsx src/index.js --ignore-dirs lib",
    "prepublish": "yarn test --coverage && yarn build",
    "release": "changeset publish",
    "test": "jest"
  },
  "dependencies": {
    "@stylistic/stylelint-plugin": "3.1.3",
    "chalk": "5.6.2",
    "chokidar": "5.0.0",
    "commander": "14.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-inclusive-language": "2.2.1",
    "eslint-plugin-jest": "28.14.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-sort-destructure-keys": "2.0.0",
    "eslint-plugin-sort-exports": "0.9.1",
    "glob": "13.0.7",
    "markdownlint": "0.40.0",
    "node-notifier": "10.0.1",
    "postcss-less": "6.0.0",
    "postcss-scss": "4.0.9",
    "process-supervisor": "1.0.0",
    "space-log": "2.1.0",
    "stylelint": "17.16.0",
    "stylelint-config-property-sort-order-smacss": "10.0.0",
    "stylelint-declaration-strict-value": "1.13.0",
    "stylelint-order": "6.0.4",
    "stylelint-scss": "6.14.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@types/eslint": "9.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "@types/node-notifier": "8.0.5",
    "@types/postcss-less": "4.0.7",
    "jest": "30.5.2",
    "knip": "6.45.1",
    "rimraf": "6.1.4",
    "rollup": "4.68.3",
    "rollup-plugin-copy": "3.5.0",
    "ts-jest": "29.4.15",
    "ts-jest-mock-import-meta": "1.3.2",
    "ts-node": "10.9.2",
    "tslib": "2.9.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "author": "Patrick Taylor <hello@patricktaylor.dev>",
  "keywords": [
    "@stylistic/stylelint-plugin",
    "eslint",
    "eslint-plugin-eslint-comments",
    "eslint-plugin-inclusive-language",
    "eslint-plugin-jest",
    "eslint-plugin-n",
    "eslint-plugin-promise",
    "eslint-plugin-sort-destructure-keys",
    "eslint-plugin-sort-exports",
    "lint",
    "markdownlint",
    "stylelint",
    "stylelint-config-property-sort-order-smacss",
    "stylelint-declaration-strict-value",
    "stylelint-order",
    "stylelint-scss"
  ],
  "license": "MIT",
  "packageManager": "yarn@4.19.0"
}
